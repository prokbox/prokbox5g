# P12 W1-A1 (H2): an alarm fires awake, Snooze, then a power-off. The
# power thread's INT1 read (powermgmt.c power_thread_rtc_process(), ~1 Hz)
# sees the alarm flag; under the shell it only clears it, so the PMU still
# holds the snoozed time with RTCWAK set, and the alarm boot at the snooze
# rings again. (Unfixed, the read wrote year 0x99 and cleared RTCWAK the
# moment the alarm fired: the first expect_pmu fails.)
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-alarm-disarm-race.script
# golden: skip
# timeout: 120
# env: IPODUI_SIM_ALARM_IN=12
# alarm-rings: 2
# log: sim_pmu: int1 alarm armed=
# log: ipodui: alarm snooze how=0
# log: sim_pmu: alarm_boot armed=
# log: expect_pmu ok
# nolog: expect_pmu failed
# nolog: alarm_boot: no wake
# reset: mainmenu
wait 16000
# ringing for ~4 s, the power thread has read INT1: still armed, RTCWAK on
expect_pmu on rtcwak=1
key PLAY
wait 3000
expect_pmu on rtcwak=1 int1=0
pmu_dump
alarm_boot 20
power_off_now
wait 3000
reboot
wait 6000
expect_pmu any bootwake=1
shot rings-again
quit
