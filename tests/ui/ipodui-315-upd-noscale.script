# #315 (a, b, e): a USB session right after boot, before any walk has
# given the library check its scale (no whole walk this boot), in which
# the computer adds songs. The update page is up on the first frame
# after the release ("update screen shown ms=0", no second's grace), and
# its bar moves while the check walks with no scale (an asymptotic fill:
# a probe-step draw with a bar above 0). Red before #315: the page came
# up only after a phase plus 1 s, and the bar stayed empty for the whole
# walk (tagcache_ui_progress() gave -1). Each walk logs its time and
# size ("db walk ms= ent= probe=").
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-315-upd-noscale.script
# needs: library
# timeout: 240
# golden: skip
# fulls-extra: 3   (the USB screen, the page, the menu after it)
# nolog: upd bar back
# logbetween: u0 u1 upd push mode=unplug shown=1
# logbetween: u0 u1 update screen shown ms=0 n=
# logbetween: u0 u1 upd draw bar=([1-9]\d*) step=1
# logbetween: u0 u1 db walk ms=\d+ ent=[1-9]\d* probe=
# logbetween: u0 u1 upd done ms=
#
# The songs are tests/ui/fixtures/refresh.mp3, copied as /Music/P315/;
# the script removes them at the end.

wait 100                # the boot; its check not yet walked
ab_mark u0
usb_connect
wait 2500
mkdir /Music/P315
copy fixtures/refresh.mp3 /Music/P315/a.mp3
copy fixtures/refresh.mp3 /Music/P315/b.mp3
scan_slow 3             # every folder 30 ms: the check lasts seconds
usb_disconnect
wait 200
shot page_first         # the page, its step and bar, at once
wait 1500
shot page_walk          # the bar moving with no scale
expect_in_db /Music/P315/a.mp3 60000
wait_db 60000
wait 3000
shot menu_after
ab_mark u1
scan_slow 0
remove /Music/P315/a.mp3
remove /Music/P315/b.mp3
update_db_wait 30000
quit
