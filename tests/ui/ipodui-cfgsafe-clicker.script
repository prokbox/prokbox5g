# cfgsafe (2026-10-26, device build 207956fb84): a changed setting is
# written within ~2 s of the change (settings_save_service(), the
# debounced save), not only when the disk next goes idle, so a hard
# reset a few seconds later keeps it. The owner lost Clicker this way.
# Settings > Clicker turned Off (from On, the default, #142), 4 s, then a
# power cut (no shutdown path runs) and a fresh boot on the same disk:
# walking back to Clicker is silent, so the setting survived (a lost save
# would come back On and click: the nolog line); Select turns it On again
# for the scripts after this one (the default). Before the fix nothing
# wrote config.cfg until the next idle flush or a clean power-off.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-cfgsafe-clicker.script
# golden: skip
# modclass: none (resident sim-ui)
# log: click n=16 btn=
# nolog: click n=17 btn=
# nolog: cfg save failed
# reset: mainmenu
wait 4000

wheel +3 300            # Settings (clicks, Clicker is On: n=1..3)
wait 400
key SELECT 50           # n=4
wait 1200
wheel +11 40            # Clicker (row 11), n=5..15
wait 800
key SELECT 50           # the press clicks (n=16); release: Off
wait 4000               # the debounced save (~2 s)
power_cut
reboot
wait 4000               # the main menu
wheel +3 300            # Settings: silent, Clicker came back Off
wait 400
key SELECT 50
wait 1200
wheel +11 40            # Clicker
wait 800
key SELECT 50           # On again (the default; pressed while Off: silent)
wait 4000               # saved
shot clicker_on        # Settings, Clicker On again (shots.sh needs one)
quit
