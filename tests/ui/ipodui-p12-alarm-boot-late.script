# P12 W1-A1 (Q17, 5.5): a power-on 200 s after the armed time is not an
# alarm boot: no ring (not rung late); the alarm is marked missed (shown
# inline by the Alarms list, W1-A2) and, being daily, its next occurrence
# is armed at the same boot (missed, then the next repeat).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-alarm-boot-late.script
# golden: skip
# timeout: 120
# env: IPODUI_SIM_ALARM_IN=600
# alarm-rings: 0
# log: ipodui: alarm missed i=0 at=
# log: sim_pmu: alarm_boot armed=
# log: expect_pmu ok
# nolog: expect_pmu failed
# nolog: ipodui: alarm boot armed=
# reset: mainmenu
wait 4000
alarm_boot 200
power_off_now
wait 3000
reboot
wait 6000
expect_pmu on rtcwak=1
shot booted
quit
