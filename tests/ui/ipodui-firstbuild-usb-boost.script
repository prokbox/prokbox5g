# p081-pageboost: USB plugged in on the first-build library page (#237).
# The page holds the build boosted (tagcache_dedicated_build()); it gives
# the hold back before the USB handler runs, so no boost is held through
# the USB session (the art builder's rule, artcache.c), and the page the
# unplug brings back takes its own. Red at bfce123111 (the page's hold
# stayed up for the whole session: the count stayed 1).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-firstbuild-usb-boost.script
# needs: library
# fresh-db
# timeout: 240
# golden: skip
# nolog: upd bar back
# nolog: upd stuck
# logbetween: b0 u0 upd push mode=boot
# logbetween: u0 u1 upd hold give why=usb
# logbetween: u0 u1 usb enter
# logbetween: u1 u2 upd push mode=boot
# logbetween: u2 u3 upd done ms=
# logbetween: u2 u3 upd dedicated depth=0

ab_mark b0
scan_slow 3           # every folder 30 ms: the build lasts seconds
wait 2500
expect_boost 1+       # the page's hold (and the build's own)
ab_mark u0
usb_connect
wait 2500
expect_boost 0 1000   # the session: nothing boosted (a frame's compose
wait 1500             # aside, so twice, a moment apart)
expect_boost 0 1000
shot usb              # the USB screen
ab_mark u1
usb_disconnect
wait 1500
expect_boost 1+ 2000  # the page again, its own hold
shot page_again
ab_mark u2
wait_db 60000
wait 3000
expect_boost 0 3000
ab_mark u3
scan_slow 0
quit
