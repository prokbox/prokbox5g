# Phase 5: Now Playing for a track without cover art (the note glyph).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-noart.script
# needs: music

wait 3000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
repeat off
wait_db 30000
art_wait 60000
play_files /Music/Square%20Wave%20Quartet/Low%20Frequencies/01%20Hum.mp3 /Music/Square%20Wave%20Quartet/Low%20Frequencies/02%20Beeps.mp3
wait 1000
np_pin 5000 50
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 1200
shot noart
audio_stop
quit
