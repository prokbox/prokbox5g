# Long session of Bricks under the simulator's device clock (`sdk_devclock
# on`: game code is charged at 30 MHz device speed, docs/design/games.md
# 5.6). Fails on any SDK budget violation or kill; the game's longest step
# is logged at exit. Random paddle sweeps, serves and level play.
#   SIM_BUILD=build/sim-ui-mod scripts/shots.sh tests/ui/ipodui-bricks-long.script
# generated by scripts/gen_gameclock_scripts.py
# needs: modules
# needs: music
# golden: skip
# timeout: 900
# reset: mainmenu
# log: sdk devclock bricks step max_us=
# log: sdk devclock bricks entries
# nolog: sdk viol bricks
# nolog: sdk kill bricks

wait 4000
sdk_clear
sdk_devclock on
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
repeat one
wait 2000
key MENU
wait 1000
wheel -20
wait 600
wheel +2             # Extras
wait 600
key SELECT
wait 1200
wheel +4             # Games
wait 600
key SELECT
wait 1200
wheel +0             # Bricks
wait 600
key SELECT
wait 1500
wheel +1 100
wait 250
key SELECT   # launch / serve
wait 700
