# Phase 5 (#27) refill with the database was left dirty (a power cut mid-commit) and rebuilds: walk the Shuffle Songs window past the
# low-water mark; the queue must stay playing and (once the library is
# usable) grow. The counter in the last shot shows the result.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-refill-dirty.script
# needs: library
# golden: skip start walked
# timeout: 150

wait 1000
wait_db 30000
art_wait 120000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
wheel +4
wait 500
key SELECT
wait 1500
dirty_db
reboot
wait 3000
wait_db 60000
wheel +4
wait 500
key SELECT
wait 1500
shot start
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
