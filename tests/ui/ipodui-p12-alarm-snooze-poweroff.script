# P12 W1-A1 (5.5): snooze survives a power-off: snooze_until persisted in
# alarms.dat and armed in the PMU; the alarm boot at the snooze rings it
# (straight to the ring screen, the boot window skipped).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-alarm-snooze-poweroff.script
# golden: skip
# timeout: 120
# env: IPODUI_SIM_ALARM_IN=12
# alarm-rings: 2
# log: ipodui: alarm snooze how=0
# log: ipodui: alarm boot armed=
# log: sim_pmu: alarm_boot armed=
# nolog: alarm_boot: no wake
# reset: mainmenu
wait 16000
key PLAY
wait 1500
alarm_boot 40
power_off_now
wait 3000
reboot
wait 6000
shot ringing-at-boot
key MENU
wait 1500
quit
