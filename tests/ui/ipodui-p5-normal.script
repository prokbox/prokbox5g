# Phase 5: Now Playing, Normal mode (docs/phase5-brief.md §6, §8): the
# album art slant, title/artist/album, "n of N", the progress row, the
# wheel's volume bar (pinned, then it leaves), the no-art placeholder.
# Plays the mini library (deterministic order); clock, battery, elapsed
# time and volume are pinned.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-normal.script
# needs: music
# trace: np
# golden: skip push_mid

wait 3000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
repeat off
wait_db 30000
art_wait 60000
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3 /Music/Tone%20Collective/Sine%20Studies/02%20Low%20E.mp3 /Music/Square%20Wave%20Quartet/Low%20Frequencies/01%20Hum.mp3
wait 1000
np_pin 12000 50
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 100
shot push_mid
wait 1500
shot normal         # art, title, artist, album, "1 of 3", bar at 0:12
wheel +3 300        # the volume bar replaces the progress row
wait 300
shot volume
wait 3000           # it leaves 2 s after the last click
shot after_volume
key NEXT            # a track change: new art, new title
wait 1500
key NEXT            # the third track has no cover art
wait 1500
shot noart
key MENU
wait 800
shot back
audio_stop
quit
