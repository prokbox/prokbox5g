# Phase 11 QW2 (Q, docs/phase11-brief.md §3.5): the volume limit's small
# triangle on Now Playing's volume bar, at ui_vol_frac(volume_limit), and
# the regenerated speakers (spec "Speaker glyphs: exact direction"). The
# limit (-20 dB) comes from a config file copied in before a reboot (no
# settings command yet), and the plain config goes back at the end.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-qw2-vlimit.script
# needs: music
# timeout: 90

wait 1000
copy fixtures/qw2/vlimit.cfg /.rockbox/config.cfg
reboot
wait 3000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
repeat off
wait_db 30000
art_wait 60000
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3 /Music/Tone%20Collective/Sine%20Studies/02%20Low%20E.mp3
wait 1000
np_pin 12000 50
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 1200
wheel +2 300
wait 300
shot limit_v50
np_pin 12000 0
wheel -2 300
wait 300
shot limit_v0
audio_stop
copy fixtures/qw2/default.cfg /.rockbox/config.cfg
quit
