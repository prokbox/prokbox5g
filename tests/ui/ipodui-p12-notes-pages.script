storage_idle
wait 1500
wheel +2            # Main Menu: "Extras"
wait 800
key SELECT
wait 1200
wheel +7            # Extras: to the last row (Stopwatch; the list does not wrap)
wait 600
wheel -2            # "Notes", counted from the end: the same with or without a Games row
wait 800
key SELECT
wait 1200
shot first          # Archive, then Meeting notes 001..
wheel +45
wait 1200
shot middle
wheel +60
wait 1200
shot end            # Meeting notes 090
wheel -100
wait 1500
shot top_again
key SELECT          # the Archive folder: its notes come as pages
wait 1200
shot folder
wheel +25
wait 1200
shot folder_end
key MENU
wait 1200
shot back_root
key MENU
wait 800
key MENU
