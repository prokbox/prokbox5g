# P12 W3-K (docs/phase12-brief.md 2.1, 3.5): a Notes index past the
# working block's cache (90 notes and a folder of 30, ~4.5 KB; the
# resident block caches ~1.4 KB) is paged: entry reads the head (header,
# directory, page 0) in one read; scrolling down the list, opening the
# folder (its notes sit after every root entry) and coming back read one
# page at a time (one open, one range read: a page load, booked apart
# under the manifest's pages rate). No viol. The notes are removed at the
# end so the other -notes-* scripts see their own eight.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-notes-pages.script
# needs: library
# timeout: 300
# modclass: paged
# log: xidx build kind=1 n=121
# log: notes open n=121 whole=0 rc=0
# log: notes page p=
# nolog: notes row blank
# golden: skip
# reset: mainmenu

