# 0.8.3 scope, upgrade safety (owner 2026-11-12): a player that ran the
# road-test build may have Settings > Audiophile saved on, with both high
# rates passed and a stereo width (tests/ui/fixtures/roadtest-audiophile.cfg:
# "ipodui high rate: on", "ipodui high rate ok: 131", "ipodui stereo
# width: 2"). 0.8.3 builds the feature out (IPODUI_AUDIOPHILE undefined,
# firmware/export/config/ipodvideo.h): those lines are unknown keys, so a
# 96 kHz 24-bit FLAC plays at 48 kHz 24-bit and no width is applied. The
# config goes in at run time (shots.sh drops these lines before boot),
# then a reboot loads it. Run on the road-test build (p083-int2) the same
# script logs "output 96000 Hz" and "stereo width 2": the positive control
# that the config did load.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p083-upgrade.script
# disk: bare
# golden: skip
# fulls-extra: 2 the Now Playing row appears (play_files) and goes (audio_stop)
# log: audio output 48000 Hz 24-bit for 96000 Hz 24-bit
# nolog: output 96000 Hz
# nolog: output 88200 Hz
# nolog: stereo width
# nolog: high rate
# timeout: 120

wait 3000
copy fixtures/roadtest-audiophile.cfg /.rockbox/config.cfg
wait 500
reboot
wait 4000
repeat all
mkdir /Music
copy fixtures/rate96k-24bit.flac /Music/up96k24.flac
wait 500
play_files /Music/up96k24.flac
wait 2500
expect_playing 1000
shot playing
audio_stop
wait 500
repeat off
rm_file /Music/up96k24.flac
quit
