# #167: songs with several artists (owner design 2026-11-06). Now Playing
# shows every artist joined with ", "; the Artists list holds the primary
# (first) artist only. Both joined lines are wider than Now Playing's
# artist line, which today ends in an ellipsis: only the title has a
# marquee (nowplaying.c), so the scrolling the design asks for is a
# Now Playing follow-up; this script checks the joined text. Fixtures
# (tests/fixtures/make_multivalue_fixtures.py):
#   mv.flac      ARTIST "Aardvark Multi", ARTIST "Aardwolf Second"
#                (and the same two ALBUMARTIST fields)
#   mv_v24.mp3   ID3v2.4 TPE1 "Aardvark Multi\0Aardwolf Second\0Abacus
#                Third With A Rather Long Name", TPE2 the first two (UTF-16)
# Before #167 Now Playing drew "Aardvark Multi" alone (expect_drawn of the
# joined line fails); indexing the joined string would add an artist row
# "Aardvark Multi, Aardwolf Second" (expect_not_drawn Aardwolf fails).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-167-multi-artist.script
# needs: library
# timeout: 200
# fresh-db
# golden: skip artists np_v24 np_flac

wait 4000
wait_db 45000
sim_clock 15:04
clock_format 24
repeat off
mkdir /Library/Multi
copy ../fixtures/mv/mv.flac /Library/Multi/mv.flac
copy ../fixtures/mv/mv_v24.mp3 /Library/Multi/mv_v24.mp3
update_db_wait_change 60000

key SELECT          # Music
wait 800
wheel +1 300        # Artists
wait 400
text_mark
key SELECT
wait 1200
shot artists        # "Aardvark Multi" at the top, no joined row
expect_drawn Aardvark Multi
expect_not_drawn Aardwolf
expect_not_drawn Abacus
key MENU
wait 700
key MENU
wait 700

play_files /Library/Multi/mv_v24.mp3
wait 1500
expect_playing 500
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10 100       # Now Playing, the last row
wait 400
text_mark
key SELECT
wait 2000
shot np_v24         # the joined artists ("Aardvark Multi, Aardw...")
expect_drawn Aardvark Multi, Aardw

text_mark
play_files /Library/Multi/mv.flac
wait 1500
expect_playing 500
wait 1500
shot np_flac
expect_drawn Aardvark Multi, Aardw
quit
