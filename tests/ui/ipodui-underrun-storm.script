# p083-copclock: a starving decode stops and restarts the PCM about once a
# second (the laptop emulator's Opus pinned at 30 MHz: ~200 times a
# track), and one "underrun mid" plus one "pcm start" line each pushed
# everything else out of the log ring. Every mid-track underrun is still
# counted; the line goes out at the first one at once, then at most once
# per 10 s with the count since the last line (new=). Three starvations:
# the first logs, the second (8 s later) is counted but held back, the
# third (16 s after the first line) logs with new=2; the fourth is held
# back again, and the stop that a new play makes says it (at=stop); a
# track change does the same (at=track).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-underrun-storm.script
# needs: library
# golden: skip
# fulls-extra: 1          (the Now Playing row appears: play_files)
# timeout: 180
# log: pcm underrun mid n=1 all=1 level_ms=0 new=1
# log: pcm underrun mid n=3 all=3 level_ms=0 new=2
# log: pcm underrun mid n=4 all=4 level_ms=0 new=1 at=track

wait 4000
repeat off
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 3000
expect_playing 1000
expect_underruns 0
pcm_starve 6000         # mid-track: the decoder gets no buffer for 6 s
wait 8000
expect_underruns 1
expect_underrun_lines 1 # the first: at once
pcm_starve 6000         # again, inside the 10 s since the line
wait 8000
expect_underruns 2      # counted
expect_underrun_lines 1 # held back (before: a second line)
pcm_starve 6000         # past the 10 s: the line, with the held one
wait 8000
expect_underruns 3
expect_underrun_lines 2
pcm_starve 6000         # inside the 10 s again: held back
wait 6800
expect_underruns 4
expect_underrun_lines 2
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 1000               # still inside the 10 s: its track change says the
expect_underrun_lines 3 # held one (no starvation goes unlogged at a stop
                        # or a track end; before, it waited for the next)
shot end
quit
