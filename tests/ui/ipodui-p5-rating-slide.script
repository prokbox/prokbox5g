# Phase 5 fix B: a Rating slide frame. The mode row slides (Scrubber ->
# Rating) over the art's reflection (np-reflection.md section 6): the
# reflection rows 198-204 must stay intact under the sliding row. The shot is
# taken a fixed 80 ms into the slide. Where the sliding row sits varies from run
# to run (1-3% of the frame), so only the art and its reflection are compared
# (`golden-region`: the art above the band, x 8-149 y 30-197, and the
# reflection's rows 201-205 left of the stars, x 8-103; rows 198-200 hold
# the sliding row's own edge, and the stars, y 203+, slide over the
# reflection from x 108, P11: it runs on behind the bar row).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-rating-slide.script
# needs: library
# golden-region: slide_mid 8 30 150 198
# golden-region: slide_mid 8 201 104 206
# trace: np

wait 1000
wait_db 30000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3 /Music/Tone%20Collective/Sine%20Studies/02%20Low%20E.mp3
wait 1000
np_pin 2000 50
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 1200
key SELECT          # Scrubber
wait 600
key SELECT          # Rating: the row slides
wait 80
shot slide_mid
wait 600
audio_stop
quit
