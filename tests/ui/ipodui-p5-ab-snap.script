# Phase 5: a fast wheel in the Scrubber snaps to chapter starts; a slow
# one moves freely. expect_pos checks where playback lands after the settle.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-ab-snap.script
# needs: music
# trace: np
# golden: skip snap
# seeks: 3

wait 3000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
repeat off
wait_db 30000
art_wait 60000
play_files /Music/Fixture%20Author/Mini%20Audiobook/Mini%20Audiobook.m4b
wait 1000
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 1200
key SELECT          # Scrubber
wait 500
wait_pos 4600       # playback lags the wall clock on a loaded host: start the wheel from the same place
# The sim posts the clickwheel driver's speed (bit 31), filtered from the
# nominal 10 ms spacing: 0, 6, 11, 16, 21, 25 clicks/s. From ~4.6 s the
# first five move freely (1+1+1+2+4 s, to ~13.6 s); the sixth is fast
# (>= 24) and snaps to the next chapter start, 22 s (Chapter 2). A free
# move there would land at ~17.6 s, outside the window.
wheel +6 10
wait 600
shot snap
expect_pos 22000 24500   # the 3rd chapter start (22 s) + playback since the settle
wheel -2 500        # slow: moves freely, one seek per click
wait 1200           # 20 s + playback since the last seek
shot free
expect_pos 20500 23500    # two 1 s steps back from it
audio_stop
quit
