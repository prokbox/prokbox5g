# #237: the power goes in the middle of a first build (the simulator dies
# mid-walk: nothing closed, flushed or shut down). The next boot has no
# library, shows the library page again and builds it, then the main
# menu with the music.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-firstbuild-powercut.script
# needs: library
# fresh-db
# timeout: 240
# golden: skip
# nolog: upd bar back
# nolog: upd stuck
# logbetween: b0 p0 upd push mode=boot
# logbetween: b0 p0 no upd done
# logbetween: p0 p1 library page at boot: no library
# logbetween: p0 p1 upd push mode=boot
# logbetween: p1 p2 upd draw bar=1000
# logbetween: p1 p2 upd done ms=
# logbetween: p1 p2 upd dedicated depth=0

ab_mark b0
scan_slow 3         # every folder 30 ms: the build lasts seconds
wait 2500
shot page_before    # the page, the walk part-way
powercut now
reboot
ab_mark p0
scan_slow 3
wait 2500
shot page_again     # the next boot: the page again
ab_mark p1
wait_db 60000
wait 3000
shot menu_after     # the main menu
ab_mark p2
scan_slow 0
key SELECT          # Music
wait 600
wheel +1            # Artists
wait 300
key SELECT
wait 800
shot artists
quit
