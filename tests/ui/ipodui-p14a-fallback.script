# Phase 14a (#64): a video the player refuses at open fails entirely
#   SIM_BUILD=build/sim-ui-video scripts/shots.sh tests/ui/ipodui-p14a-fallback.script
# (ipodui-p14a-* default to build/sim-ui-video; the gate runs them there)
# needs: video
#
# Owner, 2026-10-13 (overrides rule 1's "logged, not shown" here): a video
# that can't play no longer falls back to its audio in Now Playing. Nothing
# plays, the video screen shows the light failure prompt (the New Software
# / Reset Settings look) with the message for the reason and one OK, and
# SELECT or MENU goes back to the list. The raw reason is still logged.
#
# Disk: tests/fixtures/videos/mkvideos.sh (installed by the gate's prime
# step, or by shots.sh for a standalone run):
#   Movies/        Audio First  High Profile  Late Chapter  Short Film
# Main menu with Videos on (T1 default): Music, Videos, Podcasts, Extras,
# Settings, Shuffle Songs. Videos: Movies, TV Shows, Settings.
#
# Open-time refusals (vplayer_start() false) are classified by the shell's
# probe: High Profile (B-frames, not Baseline) -> "Format not supported";
# a file that is not an MP4 at all -> "File damaged".
#
# #286 (owner, 2026-11-13): the index marks High Profile as a video that
# can't play (reason 3, a profile the player refuses), so Movies draws it
# greyed with the can't-play glyph, and SELECT on it opens the same
# "Can't Play Video" page from the index's reason (ui_video_show_why()):
# the player is never asked and what was playing keeps playing. The probe
# path is still run on the same file through video_screen
# (ui_video_play(), what a start the index did not foresee meets): the
# same page, pixel for pixel (# same: error_format error_format_open).
# Last, with a song playing (repeat all): SELECT on High Profile shows the
# page with audio=1, PLAY on it is swallowed, MENU returns to Movies with
# High Profile still selected (# same: playing_list playing_back), and the
# song plays all along (expect_playing).
# Red (2026-11-13): with browse.c's #286 guard back to "does nothing" the
# page lines and error_format fail; with ui_video_show_why() stopping the
# audio, "page=format audio=1" and expect_playing fail.

# trace: video
# expect-file: /.rockbox/ipodui.log video failed why=open
# expect-file: /.rockbox/ipodui.log video can't play why=3 err=format
# log: browse noplay select row=1 why=3
# log: video error page=format audio=0
# log: video error page=format audio=1
# log: expect_playing ok
# nolog: expect_playing failed
# log: video error page=damaged audio=0
# log: video error dismiss key=select
# log: video error dismiss key=menu
# logafter: home np row visible=0
# nolog: video error page=other
# nolog: splash
# same: error_format error_format_open
# same: playing_list playing_back
wait 4000
wait_db 45000
art_wait 60000
wheel +1 300
wait 600
key SELECT
wait 900
key SELECT          # Movies
wait 1200
wheel +1 300        # High Profile (second of 4)
wait 400
key SELECT
wait 1500
shot error_format   # the prompt: Format not supported, OK
expect_video 0 none
key SELECT          # OK
wait 1200
shot list_after_select   # Movies, High Profile still selected
key SELECT          # again, then MENU
wait 1500
key MENU
wait 1200
shot list_after_menu

# the open-time probe on the same file: the same page
video_screen /Movies/High%20Profile.m4v
wait 1500
shot error_format_open
expect_video 0 none
key MENU
wait 1200

# not an MP4 at all: refused at open, the probe finds no boxes
copy fixtures/refresh.mp3 /.rockbox/broken.m4v
video_screen /.rockbox/broken.m4v
wait 1500
shot error_damaged_open
expect_video 0 none
key MENU
wait 1200
rm_file /.rockbox/broken.m4v

# no Now Playing row for the dead video
ab_mark home
key MENU            # Videos
wait 1000
key MENU            # main menu
wait 1200
shot main_menu

# #286: a greyed video while a song plays: the page, the song plays on
repeat all
play_files /Music/Square%20Wave%20Quartet/Low%20Frequencies/01%20Hum.mp3
wait 1500
expect_playing 300
key SELECT          # Videos (the main menu kept it)
wait 900
key SELECT          # Movies
wait 1200
wheel +1 300        # High Profile
wait 600
shot playing_list
key SELECT
wait 1500
shot error_format_playing   # the page; the header's play mark
expect_playing 500
key PLAY            # swallowed: the song plays on
wait 600
expect_playing 300
key MENU
wait 1200
shot playing_back
expect_playing 500
audio_stop
repeat off
