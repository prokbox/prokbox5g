# Phase 16-1 review (H1/M1): the window's restart is ONE audio-thread
# event (playback.c audio_on_give()); USB connected during it: the
# restart finishes first (the USB events wait in the queues), then the
# USB session runs; afterwards a song plays and stops with events.
# give_hold makes the restart wait 5 s after the buffer change, so the
# event lands inside it; it is handled after the restart, which ends
# cleanly ("audio give done"), and nothing stays suppressed afterwards.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p16-restart-usb.script
# needs: library
# needs: ab
# golden: skip
# fulls-extra: 3   (play_files rows, the USB screen)
# timeout: 300
# log: audio give held
# logbetween: held end audio give done
# logbetween: after end stats finish

wait 4000
wait_db 45000
mkdir /Audiobooks/E16
copy ../../build/ab-fixtures/pref.m4b /Audiobooks/E16/pref.m4b
copy ../../build/ab-fixtures/short.m4b /Audiobooks/E16/short.m4b
update_db_wait_change 60000
play_files /Audiobooks/E16/pref.m4b
wait_pos 17000 90000
snapshot_pause
expect_paused 500
backlight_expire            # dark
pause_age 200               # paused 3 min 20 s: the window is open
give_hold 5000              # the next window restart holds 5 s
copy ../../tests/fixtures/plain.mp3 /Audiobooks/E16/new.mp3
update_db                   # its commit takes the window's memory
wait 2500                   # ... and the restart is held now
ab_mark held
usb_connect
wait 6000
usb_disconnect
wait 4000
ab_mark after
play_files /Audiobooks/E16/short.m4b
wait_pos 16000 90000
audio_stop
wait 1500
shot after_usb
key MENU                    # the face goes
wait 1000
quit
