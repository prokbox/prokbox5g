# P19 ucop-fix (owner bench sitting 3, 2026-10-26: a tone while scrolling
# with the UI on the COP, artefacts with music). The mixer, the PCM
# driver's lock and the beep buffers are CPU-only code; a click the split-off
# ui thread asks for is posted to be_svc (BE_SOUND) and played there. The
# simulator has one core, so it runs the split at "cpu" (the same route:
# fe_be_route() is true on the ui thread in both split modes) and checks
# that every click reaches be_svc, with music stopped and while it plays,
# and that the wheel's input notes (BE_INPUT_NOTE, a post) keep the shell
# responsive. Clicker On for the run, Off and the switch removed at the end.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p19-ucop-click.script
# needs: music
# golden: skip
# log: fe be_svc up mode=cpu
# log: fe sound=0 on=svc
# log: click n=6 btn=
# log: click n=12 btn=
# log: expect_playing ok
# nolog: expect_playing failed
# timeout: 120
wait 2000
copy fixtures/p19/ui_split_cpu /.rockbox/ui_split
reboot
wait 4000

wheel +20 40            # the last row: Shuffle Songs (the rows above
wait 400                # it depend on the disk: Videos, Podcasts)
wheel -1 200            # Settings
wait 400
key SELECT 50
wait 1200
wheel +11 40            # Clicker (row 11)
wait 800
key SELECT 50           # On (pressed while Off: no click)
wait 800
wheel +3 200            # 3 clicks, music stopped: be_svc plays them
wait 300
wheel -3 200            # 3 clicks
wait 600
shot clicker_on_split

play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 1500
expect_playing 400
wheel +3 200            # 3 clicks over the music
wait 300
wheel -3 200            # 3 clicks, back on Clicker
wait 600
expect_playing 400
key SELECT 50           # the press clicks; the release turns it Off
wait 800
shot clicker_off_split
rm_file /.rockbox/ui_split
quit
