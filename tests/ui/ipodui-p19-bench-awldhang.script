# The bench session's restart-and-resume path in the simulator, at an
# early step (sitting 4gh): the re-verify run as ipodui-p19-bench-reverify,
# but awld (the LCD supply at rest, before jvpu, on the resident image)
# freezes the unit (bench_sim set hang_awld: the sim's row blocks, as a
# unit left dark).  The script restarts it (the owner's MENU+SELECT),
# opens Bench session and picks Go on: Resume records awld as hung
# ("restarted during the step"), never runs pre, s05 or boot again, and
# carries on at jvpu with the display driver there (the stage flags
# bring it back at every start), so jvpu passes and the verified line
# is still earned.  bench_sim expect checks every pick once, in order.
# Generated by scripts/bench_sim_script.py (awldhang); edit that, not this.
# needs: video
# golden: skip
# np: viz-full
# reset: viz
# env: SIM_VCHECK=1
# log: awld: hanging (fault switch, sim)
# log: start: display driver yes
# log: vlong: PASS: pictures in step with the audio
# log: duty: Not run (sim)
# log: ui switch cleared
# nolog: next start: ui cop
# nolog: glass owned STALE
# nolog: bench_sim: watchdog
# timeout: 360
wait 4000
bench_sim reset          # no results files, the model's defaults
copy ../../bcmfw/video/vcheck.bin /.rockbox/vcheck.bin
rm_file /.rockbox/.sim_vcheck_band
rm_file /.rockbox/.sim_vcheck_bad
video_start /Misc/S01E03.m4v   # this unit's check result
wait 4000
video_stop
wait 500
bench_sim set ui_split cop  # an earlier session's switch
wheel +20 40            # the last row (Now Playing while music plays)
wait 400
wheel -1 200            # Settings
wait 400
key SELECT
wait 1200
key SELECT              # About
wait 1500
chord SELECT+LEFT 3200  # Developer
wait 1000
wheel +1 200            # Bench session
wait 400
key SELECT
wait 1200
wheel +40 10          # Re-verify the video image
wait 400
wheel -3 200
wait 400
key SELECT
wait 800
wheel +40 10          # the confirm screen: start
wait 400
key SELECT
wait 800
wheel +40 10          # Hands off now (pgrd, preg, awxm, prtc)
wait 400
key SELECT
wait 800
wheel +40 10          # Seconds counter: start
wait 400
key SELECT
wait 800
# -- boot (Display program): the restart
wheel +40 10          # Display program: start
wait 400
key SELECT
wait 800
wheel +40 10          # Now restart: close
wait 400
key SELECT
wait 800
key LEFT                # the stopped-session screen: leave
wait 800
shot boot_asked
reboot
wait 4000
wheel +20 40            # the last row (Now Playing while music plays)
wait 400
wheel -1 200            # Settings
wait 400
key SELECT
wait 1200
key SELECT              # About
wait 1500
chord SELECT+LEFT 3200  # Developer
wait 1000
wheel +1 200            # Bench session
wait 400
key SELECT
wait 1200
wheel +40 10          # Go on: Display program
wait 400
wheel -2 200
wait 400
key SELECT
wait 800
wheel +40 10          # Hands off now
wait 400
key SELECT
wait 800
wheel +40 10          # Automatic checks done
wait 400
key SELECT
wait 800
# -- Visualiser on the chip
wheel +40 10          # Visualiser on the chip: start screen, SELECT: leave
wait 400
key SELECT
wait 800
key LEFT                # the do-it-outside screen: close
wait 800
key LEFT                # the stopped-session screen: leave
wait 800
key LEFT                # out of Developer (a list: LEFT)
wait 800
key MENU                # About > Settings > Main
wait 800
key MENU
wait 800
key MENU
wait 800
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 1500
wheel +20 40             # Now Playing (the main menu's last row)
wait 400
key SELECT
wait 1500
key SELECT               # Scrubber
wait 400
key SELECT               # Rating
wait 600
key SELECT               # Shuffle
wait 600
key SELECT               # Visualizer
wait 3000                # the visualiser on the panel
