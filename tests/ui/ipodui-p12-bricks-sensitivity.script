# P12 (docs/design/games.md Bricks settings): Paddle Speed. Five levels
# (Slow, Normal, Fast, Faster, Fastest; Normal by default) set how far a
# wheel click moves the paddle. The same six clicks from the left wall
# take it further at each level. Each shot is taken after the pause menu
# (Settings, Paddle Speed value list, SELECT on a level) and six clicks.
#   SIM_BUILD=build/sim-ui-mod scripts/shots.sh tests/ui/ipodui-p12-bricks-sensitivity.script
# needs: modules
# reset: mainmenu

wait 4000
sdk_clear            # a fresh game, Paddle Speed Normal
wheel +2             # Extras
wait 600
key SELECT
wait 1200
wheel +4             # Games
wait 600
key SELECT
wait 1200
wait 600
key SELECT           # Bricks
wait 800
wheel -40 20         # the left wall
wait 300
wheel +6 40
wait 300
shot normal          # six clicks at Normal
key MENU             # the pause menu
wait 600
wheel +2 300         # Settings
wait 400
key SELECT
wait 1200
wheel +2 300         # Paddle Speed row
wait 400
shot rows            # Speed, Balls, Paddle Speed (Normal)
key SELECT           # its value list
wait 600
shot values          # Slow .. Fastest
wheel -1 300         # Slow
wait 400
key SELECT
wait 600
key MENU             # back to the pause menu
wait 1200
key SELECT           # Resume
wait 800
wheel -40 20
wait 300
wheel +6 40
wait 300
shot slow            # six clicks at Slow
key MENU
wait 600
wheel +2 300
wait 400
key SELECT
wait 1200
wheel +2 300
wait 400
key SELECT
wait 600
wheel +4 300         # Fastest
wait 400
key SELECT
wait 600
key MENU
wait 1200
key SELECT           # Resume
wait 800
wheel -40 20
wait 300
wheel +6 40
wait 300
shot fastest         # six clicks at Fastest
quit
