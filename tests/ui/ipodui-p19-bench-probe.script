# The core layout probe in the simulator (sitting 4h): Developer > Bench
# session > Core layout probe, end to end, through the real menus.  The
# simulator has no second core and no interrupt controller, so it refuses
# the rows that need one rather than model a pass (devbench_sim.c
# cop_row: "Not run (sim)", the route [hypothesis] until the bench): p2
# and duty skip, asking nothing.  p1 has its fault switch on (bench_sim
# set fail_p1), so its tone question still shows and is answered "Yes";
# the row fails all the same.  The end: each pick once, in order
# (devbench.h bench_probe_picks), the end line, no verified line.
# Generated by scripts/bench_sim_script.py (probe); edit that, not this.
# needs: video
# golden: skip
# log: p2: Not run (sim)
# log: duty: Not run (sim)
# log: p1: FAIL
# nolog: bench_sim: watchdog
# timeout: 120
wait 4000
bench_sim reset          # no results files, the model's defaults
bench_sim set fail_p1    # p1 fails, so its question still shows
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 1500                # the album the probe's confirm asks for
wheel +20 40            # the last row (Now Playing while music plays)
wait 400
wheel -2 200            # Settings
wait 400
key SELECT
wait 1200
key SELECT              # About
wait 1500
chord SELECT+LEFT 3200  # Developer
wait 1000
wheel +1 200            # Bench session
wait 400
key SELECT
wait 1200
wheel +40 10          # Core layout probe
wait 400
wheel -1 200
wait 400
key SELECT
wait 800
wheel +40 10          # the confirm screen: start
wait 400
key SELECT
wait 800
# -- p2: hands off (the first step: no hands-off screen)
wheel +40 10          # Second core timer: start
wait 400
key SELECT
wait 800
wheel +40 10          # Automatic checks done
wait 400
key SELECT
wait 800
# -- p1: the tone
wheel +40 10          # Tone on the second core: start
wait 400
key SELECT
wait 800
wheel +40 10          # p1: Yes (the row failed by its switch)
wait 400
wheel -3 200
wait 400
key SELECT
wait 800
# -- duty: hands off, dark
wheel +40 10          # Hands off now
wait 400
key SELECT
wait 800
wheel +40 10          # Dark play, both cores: start
wait 400
key SELECT
wait 800
shot summary
bench_sim dump
bench_sim expect order ended noverified notoken p2=skip p1=fail duty=skip
key LEFT                # the stopped-session screen: leave
wait 800
key LEFT                # out of Developer (a list: LEFT)
wait 800
key MENU                # About > Settings > Main
wait 800
key MENU
wait 800
key MENU
wait 800
wait 1000
