# Phase 8b-4a (owner 2026-10-20, spec main-menu.md "Panel transitions"):
# the right panel's arrival when the highlighted row changes inside a
# split screen. Recorded at 30 fps (pslide_frames/) for the contact sheet:
#   1 slideshow -> fixed   Music -> Podcasts: the drift slides out right
#   2 fixed -> fixed       Podcasts -> Extras: the cross-fade
#   3 fixed -> slideshow   Settings -> Shuffle Songs: the drift slides in
#   4 slideshow -> other slideshow  Music menu Playlists -> Audiobooks:
#                          the cross-fade to the book cover
# then a fast spin over the main menu (trace: "panel show ... how=").
# Only rest shots; the in-between frames depend on timing (no goldens).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p8b-panel-slide.script
# needs: library
# trace: panelset driftrepeat
# golden: skip c1_podcasts c2_extras c3_shuffle c4_books spin_rest

wait 4000           # boot to the main menu, "Music" selected
wait_db 30000
art_wait 120000
sim_clock 15:04
clock_format 24
battery 100
wait 1500

wheel +1            # 1: Music (drift) -> Podcasts (fixed)
record 400 30 pslide
wait 300
shot c1_podcasts

wheel +1            # 2: Podcasts -> Extras (fixed -> fixed)
record 400 30 pslide
wait 300
shot c2_extras

wheel +1            # Settings (fixed)
wait 800
wheel +1            # 3: Settings -> Shuffle Songs (fixed -> drift)
record 400 30 pslide
wait 300
shot c3_shuffle

wheel -4            # Music
wait 800
key SELECT          # the Music menu, "Playlists" (drift)
wait 1500
wheel +6            # 4: Playlists -> Audiobooks (music -> books drift)
record 500 30 pslide
wait 300
shot c4_books

key MENU            # the main menu, "Music"
wait 1500
wheel +4 30         # a fast spin to Shuffle Songs: Podcasts, Extras and
wait 50             # Settings are passed, not each animated
wheel -4 30
wait 1500
shot spin_rest
quit
