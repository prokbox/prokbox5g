# Phase 9 Rev 1 H2: with tree.c compiled out (IPODUI_TRIM_BROWSER), the
# post-USB rescan moved to misc.c's system_restore_db()
# (tagcache_start_scan(): Q_START_SCAN, the deleted-file and new-file
# scans). An album copied onto the disk while USB is connected is in the
# database, and in Albums, after the disconnect, with no other trigger
# (no update_db). Path: SYS_USB_CONNECTED -> default_event_handler_ex() ->
# system_flush() ... USB screen ... system_restore() -> system_restore_db()
# -> tagcache_start_scan() (UI thread; the scan runs on the tagcache
# thread), in the playing state.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p9-usb-rescan.script
# needs: library
# timeout: 150
# log: p9 restore: tagcache scan
# golden: skip albums
#
# The album is tests/ui/fixtures/refresh.mp3 (artist/album "Refresh
# Fixture", title "Aardvark Refresh"), copied as /Music/P9Rescan/. A
# leftover of an interrupted run is removed (and rescanned) first; the
# script removes it again at the end.

wait 4000
wait_db 30000
remove /Music/P9Rescan/rescan.mp3
update_db_wait 30000
repeat all
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 1500
db_mark

usb_connect
wait 2500
mkdir /Music/P9Rescan
copy fixtures/refresh.mp3 /Music/P9Rescan/rescan.mp3
usb_disconnect
expect_db_grew 45000
expect_in_db /Music/P9Rescan/rescan.mp3 30000
wait_db 45000

key SELECT          # Music
wait 800
wheel +2 300        # "Albums"
wait 400
key SELECT
wait 1500
shot albums         # Albums opens after the rescan (state is asserted above; no golden)

key MENU
wait 800
key MENU
wait 800
audio_stop
remove /Music/P9Rescan/rescan.mp3
update_db_wait 30000
quit
