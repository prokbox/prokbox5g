# #237, owner 2026-11-09: a first build on the charger below 15 %; the
# charger pulled mid-build: a clean stop at the next folder (the walk
# ends, its candidate is dropped, nothing is published), the page says
# to connect to power; the charger back: the build again, then the menu
# with the music. Starting below 15 % with no charger:
# ipodui-firstbuild-lowbatt.script.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-firstbuild-chargeroff.script
# needs: library
# fresh-db
# timeout: 300
# golden: skip
# env: IPODUI_SIM_BATT_MV=3420
# env: IPODUI_SIM_DRAINED=0
# env: IPODUI_SIM_CHARGER=1
# nolog: upd bar back
# nolog: upd stuck
# logbetween: c0 c1 upd push mode=boot
# logbetween: c0 c1 no library page: waits for power
# logbetween: c0 c1 upd draw bar=([1-9]\d*) step=2
# logbetween: c1 c2 library page: waits for power batt=1[0-4]
# logbetween: c1 c2 db candidate drop
# logbetween: c1 c2 upd draw bar=\d+ step=-2
# logbetween: c1 c2 no upd done
# logbetween: c1 c2 upd dedicated depth=0
# logbetween: c2 c3 library page: power back
# logbetween: c2 c3 upd done ms=
# logbetween: c2 c3 upd dedicated depth=0

# 3,420 mV: 12 % on the sim's line; the charger in from the power-on
ab_mark c0
scan_slow 3         # every folder 30 ms: the build lasts seconds
wait 3000
shot building       # on the charger: the build runs
ab_mark c1
charger off
wait 3000
shot wait_power     # "Connect to power to finish your library."
ab_mark c2
charger on
wait_db 60000
wait 6000           # the probe the cut owes runs too
shot menu_after     # the main menu
ab_mark c3
scan_slow 0
key SELECT          # Music
wait 600
wheel +1            # Artists
wait 300
key SELECT
wait 800
shot artists
quit
