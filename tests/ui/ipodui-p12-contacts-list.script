# P12 W3-K (docs/phase12-brief.md 3.5, 9 "-contacts-*"): vCard files copied over USB are indexed at the post-USB moment. The list is
# every card as "Given Family" in First-name order (the sidecar and the .txt
# are left out; a card with only a phone is listed by it, an organisation by
# its name, a card with nothing is dropped); one open and one read.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-contacts-list.script
# needs: library
# timeout: 180
# log: xidx build kind=2 n=9
# log: contacts open n=9 whole=1 last=0 rc=0
# nolog: contacts win
# nolog: modclass viol
# golden: skip
# reset: mainmenu

sim_clock 15:06
wait 4000
wait_db 30000
rm_file /Contacts/family.vcf
rm_file /Contacts/work.vcf
rm_file /Contacts/modern.vcf
rm_file /Contacts/big.vcf
rm_file /Contacts/big2000.vcf
rm_file /Contacts/._family.vcf
rm_file /Contacts/readme.txt
rm_file /.rockbox/contacts.idx
rm_file /.rockbox/xindex.owe

usb_connect
wait 2500
mkdir /Contacts
copy fixtures/contacts/family.vcf /Contacts/family.vcf
copy fixtures/contacts/._family.vcf /Contacts/._family.vcf
copy fixtures/contacts/work.vcf /Contacts/work.vcf
copy fixtures/contacts/modern.vcf /Contacts/modern.vcf
copy fixtures/contacts/readme.txt /Contacts/readme.txt
usb_disconnect
wait 150
wait_db 45000
wait 3500           # the grace and gap windows end the busy moment: the
storage_idle        # indexer runs there (xidx build)
wait 1500
wheel +2            # Main Menu: "Extras"
wait 800
key SELECT
wait 1200
wheel +2            # Extras: "Contacts" (Clocks, Calendars, Contacts)
wait 800
key SELECT
wait 1200
shot list
wheel +3
wait 600
shot list_down
key MENU
wait 1000
shot back_extras
quit
