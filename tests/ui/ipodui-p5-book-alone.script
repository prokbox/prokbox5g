# Phase 5 Revision 2: a book plays alone: started from Audiobooks it queues
# only that book, shows chapter N of M, and ends by STOPPING (not by running
# into the next book), even with Repeat All on.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-book-alone.script
# needs: music
# golden: skip tick near_end stopped
# timeout: 120

wait 3000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
repeat off
repeat all
key SELECT          # Music
wait 800
wheel +5 300
wait 400
shot music_list
key MENU
wait 500
play_files /Music/Fixture%20Author/Mini%20Audiobook/Mini%20Audiobook.m4b
wait 1000
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 1200
shot book_start   # album line = chapter title, counter "chapter 1 of 4"
key NEXT            # next chapter
wait 1500
shot chapter2
key SELECT          # Scrubber: chapter ticks on the bar
wait 800
shot ticks
wheel +30 10        # fast spin: snaps to chapter starts
wait 1000
shot snapped
wait 60000          # past the end (48 s book), Repeat All on
shot stopped        # stopped: the screen popped
repeat off
quit
