# P12 W3-K (docs/phase12-brief.md 3.5, 9 "-contacts-*"): a card's page: the organisation in grey, then labelled blocks (phones, e-mails,
# address, birthday, note); the wheel scrolls it a line a step, NEXT a page.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-contacts-card.script
# needs: library
# timeout: 180
# log: xidx build kind=2
# log: contacts view
# nolog: modclass viol
# golden: skip
# reset: mainmenu

sim_clock 15:06
wait 4000
wait_db 30000
rm_file /Contacts/family.vcf
rm_file /Contacts/work.vcf
rm_file /Contacts/modern.vcf
rm_file /Contacts/big.vcf
rm_file /Contacts/big2000.vcf
rm_file /Contacts/._family.vcf
rm_file /Contacts/readme.txt
rm_file /.rockbox/contacts.idx
rm_file /.rockbox/xindex.owe

usb_connect
wait 2500
mkdir /Contacts
copy fixtures/contacts/family.vcf /Contacts/family.vcf
copy fixtures/contacts/work.vcf /Contacts/work.vcf
copy fixtures/contacts/modern.vcf /Contacts/modern.vcf
usb_disconnect
wait 150
wait_db 45000
wait 3500           # the grace and gap windows end the busy moment: the
storage_idle        # indexer runs there (xidx build)
wait 1500
wheel +2            # Main Menu: "Extras"
wait 800
key SELECT
wait 1200
wheel +2            # Extras: "Contacts" (Clocks, Calendars, Contacts)
wait 800
key SELECT
wait 1200
wheel +1            # Acme Plumbing, Ada Lovelace
wait 600
key SELECT
wait 1200
shot top
wheel +4
wait 600
shot down4
key NEXT
wait 600
shot page2
wheel +60
wait 600
shot end
key MENU
wait 1000
shot back_list
wheel +5
wait 600
key SELECT          # Selcuk Oztuerk: organisation, QP text
wait 1200
shot qp_card
key MENU
wait 800
key MENU
wait 800
quit
