# P12 W4 (docs/design/sdk.md 3.1, 13.3): the exit chord in Chute.
# SELECT + PREV overlapping 1.9 s does nothing (no skip back; the game
# plays on); held 2.3 s it leaves through the graceful exit, back to the
# Games list.
#   SIM_BUILD=build/sim-ui-mod scripts/shots.sh tests/ui/ipodui-p12-chute-chord.script
# needs: modules
# reset: mainmenu

wait 4000
sdk_clear            # a fresh game
wheel +2             # Extras
wait 600
key SELECT
wait 1200
wheel +4             # Games
wait 600
key SELECT
wait 1200
wheel +2             # Chute, below Bricks and Chess
wait 600
key SELECT           # Chute
wait 800
press_hold SELECT PREV 1900
wait 600
shot after_1900
press_hold SELECT PREV 2300
wait 1500
shot exited          # the Games list
quit
