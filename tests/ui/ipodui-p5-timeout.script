# Phase 5: every mode drops to Normal after 4 s without input
# (NP_MODE_TIMEOUT_MS), and a track change or a playback stop does too.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-timeout.script
# needs: music
# golden: skip slide_back after_next
# golden-region: popped 0 0 160 240
# (popped: the menu side only. After the stop the main menu has no Now
# Playing row (Phase 6 Revision 3), so the cursor rests on Shuffle Songs,
# whose panel shows a time-varying pick of album art)

wait 3000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
repeat off
wait_db 30000
art_wait 60000
play_files /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3 /Music/Tone%20Collective/Sine%20Studies/02%20Low%20E.mp3 /Music/Tone%20Collective/Sine%20Studies/03%20Warble.mp3
wait 1000
np_pin 2000 50      # a pinned clock: the elapsed time is in the shots
key SELECT          # Music (the menu re-reads "Now Playing" after a push/pop)
wait 700
key MENU
wait 700
wheel +10           # "Now Playing"
wait 500
key SELECT
wait 1200
key SELECT          # Scrubber
wait 3000
shot at_3s          # still Scrubber
wait 1500
shot slide_back     # past 4 s: sliding back / Normal
wait 800
shot at_5s          # Normal
key SELECT
wait 600
key SELECT          # Rating
wait 600
shot rating
key NEXT            # a track change mid-Rating drops to Normal
wait 1500
shot after_next
key SELECT
wait 600
wait_index 2 5000   # the stop always happens on track 2 (the panel shows
                    # the art of the track current at the stop)
audio_stop          # playback stops: the screen pops
wait 1500
shot popped
quit
