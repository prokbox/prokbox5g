# #157 on the #237 page (owner 2026-11-09: the menu after an unplug shows
# the music as it is): a USB session adds songs; after the unplug "OK to
# Disconnect" with the ejected pictogram and the bar stays up while the
# library takes them in (keys do nothing), then the main menu, and the new
# songs are in the library. A session that changed nothing shows no page.
# #315: the page is up on the first frame after the release (no second's
# grace when files changed).
# Red on 0.8.0's code: no page (no "upd push"), the menu at once.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-upd-unplug.script
# needs: library
# timeout: 300
# golden: skip
# nolog: upd bar back
# logbetween: s0 s1 no upd show
# logbetween: s0 s1 no upd draw
# logbetween: l0 l1 upd push mode=unplug shown=1
# logbetween: l0 l1 update screen shown ms=0 n=
# logbetween: l0 l1 upd draw bar=([1-9]\d*) step=
# logbetween: l0 l1 upd key ignored
# logbetween: l0 l1 no upd done
# logbetween: l1 l2 upd draw bar=1000
# logbetween: l1 l2 upd done ms=
# logbetween: l1 l2 upd dedicated depth=0

wait 4000
wait_db 30000
art_wait 60000
remove /Music/FbUpd/a.mp3
remove /Music/FbUpd/b.mp3
update_db_wait 30000

# 1. A session that changed nothing: no page
ab_mark s0
usb_connect
wait 2500
usb_disconnect
wait 4000
shot short_after        # the main menu
ab_mark s1

# 2. New songs: the page until the library has them
usb_connect
wait 2500
mkdir /Music/FbUpd
copy fixtures/refresh.mp3 /Music/FbUpd/a.mp3
copy fixtures/refresh.mp3 /Music/FbUpd/b.mp3
scan_slow 3             # every folder 30 ms: the update lasts seconds
usb_disconnect
ab_mark l0
wait 2500
shot page               # OK to Disconnect, the bar, the step
key MENU
wheel +2
key SELECT
wait 500
shot page_keys          # still the page
ab_mark l1
expect_in_db /Music/FbUpd/a.mp3 60000
wait_db 60000
wait 3000
shot menu_after         # the main menu
ab_mark l2
scan_slow 0

remove /Music/FbUpd/a.mp3
remove /Music/FbUpd/b.mp3
update_db_wait 30000
quit
