# Phase 5 (#27): Shuffle Songs from the main menu plays a 50-entry window of
# the library; it refills in the background while the queue is walked (NEXT
# 45 times: the window passes the low-water mark of 10 left and grows).
# The counter shows the queue ("n of 50", then "n of 100" after the refill).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p5-shuffle-songs.script
# needs: library
# trace: shuf
# golden: skip start walked
# timeout: 120

wait 1000
wait_db 30000
art_wait 120000
sim_clock 15:08
clock_format 24      # P11: the default is 12-hour; this golden shows 24
wheel +4            # "Shuffle Songs"
wait 500
key SELECT          # plays; Now Playing is pushed
wait 1500
shot start          # "1 of 50"
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
key NEXT
wait 200
wait 3000
shot walked         # "46 of 100"
audio_stop
quit
