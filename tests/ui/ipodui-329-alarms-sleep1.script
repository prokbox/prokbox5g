# #329: Extras > Alarms, the Sleep Timer's last minutes in the panel.
# The engine's test hook starts a 2-minute timer at boot (the menu's
# least is 15 min); with its row highlighted the caption reads "Sleep
# Timer Active" over "2 Minutes", then the once-a-minute tick turns it to
# "1 Minute" with a band push, and the row's subtitle to "1 Minute Left".
# The script quits before the timer ends. The rest of the panel is
# ipodui-329-alarms.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-329-alarms-sleep1.script
# golden: skip
# timeout: 120
# env: IPODUI_SIM_SLEEP_TIMER=2
# log: ipodui: alarms panel left=2
# log: ipodui: alarms panel left=1
# reset: mainmenu

wait 4000
rtc_at 2026-10-06 15:06:00
sim_clock 15:06
wheel +2              # Extras
wait 700
key SELECT
wait 1200
wheel +3              # Alarms
wait 800
key SELECT
wait 1500
wheel +1              # Sleep Timer
wait 1000
shot sleep_2min       # "Sleep Timer Active" / "2 Minutes"
wait 56000            # the timer started at boot: past its first minute
shot sleep_1min       # "Sleep Timer Active" / "1 Minute"
key MENU
wait 1000
quit
