# #214: a queue that crosses output formats plays through with a seamless
# switch at each boundary: no drain and no re-buffer (no rate gap, no
# REMAKE), every sample before the boundary handed to the output and
# none after it (the sample check), and the soft edge on both sides.
#   48 kHz 16-bit FLAC -> 96 kHz 24-bit FLAC (48/24 with Audiophile off:
#   a depth switch) -> 22.05 kHz MP3 (44.1 kHz, 24-bit by #289: a rate
#   switch)
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p090-rsw.script
# needs: library
# golden: skip
# fulls-extra: 2          (the main menu gains its Now Playing row at play_files and loses it at audio_stop)
# log: pcm fsw n=1 48000/24
# log: pcm fsw n=2 44100/24
# log: pcm fsw chk=ok
# nolog: rate gap

wait 4000
copy fixtures/rate48k.flac /Music/rsw48k.flac
copy fixtures/rate96k-24bit.flac /Music/rsw96k24.flac
wait 500
play_files /Music/rsw48k.flac /Music/rsw96k24.flac /Music/Tone%20Collective/Sine%20Studies/01%20Concert%20A.mp3
wait 20000              # 4 s + 6 s, then into the MP3
expect_playing 1000
expect_fmt_switches 2   # 48/16 -> 48/24 -> 44.1/24, every check ok
expect_rate_gaps 0      # (0.8.3: a drain and re-buffer at each)
expect_underruns 0
expect_underrun_lines 0
shot end
audio_stop
rm_file /Music/rsw48k.flac
rm_file /Music/rsw96k24.flac
quit
