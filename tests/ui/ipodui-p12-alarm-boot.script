# P12 W1-A1 (5.2): an RTC power-on 30 s after the armed time is an alarm
# boot (within ALARM_BOOT_WIN_S = 120 s): the boot glyph, then the ring
# screen; nothing is re-armed or written until the ring ends.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-alarm-boot.script
# golden: skip
# timeout: 120
# env: IPODUI_SIM_ALARM_IN=600
# alarm-rings: 1
# log: ipodui: alarm boot armed=
# log: ipodui: alarm dismiss how=1
# log: sim_pmu: alarm_boot armed=
# reset: mainmenu
wait 4000
alarm_boot 30
power_off_now
wait 3000
reboot
wait 6000
shot ringing-at-boot
key MENU
wait 1500
quit
