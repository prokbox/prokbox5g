# Owner, 2026-10-13: a video that fails while playing fails entirely
#   SIM_BUILD=build/sim-ui-video scripts/shots.sh tests/ui/ipodui-p14a-error-runtime.script
# needs: video
#
# The player reporting VPC_FAILED stops the audio (the whole track), drops
# the queue's resume point, and the video screen turns into the light
# failure prompt (slides in as a push); SELECT or MENU goes back to the
# list. The sim fakes the failure: /.rockbox/.sim_vfail<why> makes the
# shell read that fail_why at its first poll (apps/ipodui/screens/video.c,
# simulator only). One shot per message group:
#   6 (HP_E_NOMEM)   -> "Video too large"
#   8 (HP_E_CORRUPT) -> "File damaged"
#   -2 (BVP_E_TIMEOUT) -> "Video didn't start"
#   5 (HP_E_UNSUPPORTED, a size/mode the image refuses) -> "Format not supported"
# Movies: Audio First (row 1, a playable Baseline file) is played each time.

# trace: video
# expect-file: /.rockbox/ipodui.log video failed why=5
# log: video failed why=8
# log: video failed why=-2
# log: video failed why=6
# log: video error page=large audio=0
# log: video error page=damaged audio=0
# log: video error page=other audio=0
# log: video error page=format audio=0
# log: video error dismiss key=select
# log: video error dismiss key=menu
# logafter: home np row visible=0
# nolog: splash
wait 4000
wait_db 45000
art_wait 60000
rm_file /.rockbox/.sim_vfail6
rm_file /.rockbox/.sim_vfail8
rm_file /.rockbox/.sim_vfail-2
rm_file /.rockbox/.sim_vfail5
wheel +1 300
wait 600
key SELECT
wait 900
key SELECT          # Movies
wait 1200

copy fixtures/refresh.mp3 /.rockbox/.sim_vfail6
key SELECT          # Audio First
wait 2000
shot error_large
expect_video 0 none
key SELECT
wait 1200
shot list_after_select
rm_file /.rockbox/.sim_vfail6

copy fixtures/refresh.mp3 /.rockbox/.sim_vfail8
key SELECT
wait 2000
shot error_damaged
key MENU
wait 1200
shot list_after_menu
rm_file /.rockbox/.sim_vfail8

copy fixtures/refresh.mp3 /.rockbox/.sim_vfail-2
key SELECT
wait 2000
shot error_other
key PLAY            # swallowed: the stopped queue stays stopped
wait 600
key SELECT
wait 1200
rm_file /.rockbox/.sim_vfail-2

copy fixtures/refresh.mp3 /.rockbox/.sim_vfail5
key SELECT
wait 2000
shot error_format
storage_idle         # the 12-line log ring is flushed here, before video-end and
                    # panel lines overwrite the failure lines it must hold
key SELECT
wait 1200
rm_file /.rockbox/.sim_vfail5

ab_mark home
key MENU            # Videos
wait 1000
key MENU            # main menu
wait 1200
shot main_menu      # no Now Playing row
