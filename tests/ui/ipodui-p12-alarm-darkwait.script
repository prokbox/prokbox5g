# P12 W1-A1 (Q1(2), Q28): an alarm due within 24 h and no bootloader
# alarm window: hold PLAY takes the dark wait (screen off, awake), not the
# power-off; the alarm then rings out of the dark wait, lit; hold PLAY on
# the ring dismisses (Q5) and goes dark again (tomorrow's alarm is due
# within 24 h).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-alarm-darkwait.script
# golden: skip
# env: IPODUI_SIM_ALARM_IN=20
# Trace: alarm darkwait next=<t>, alarm ring i=0, alarm dismiss how=1,
#        alarm darkwait (again); no "power off"
# alarm-rings: 1
# log: ipodui: alarm darkwait next=
# nolog: ipodui: sleep tier=off
# trace: piezo
# reset: mainmenu
wait 5000
hold PLAY 1500
wait 2000
shot dark
wait 17000
shot ringing
hold PLAY 1500
wait 2000
shot dark-again
quit
