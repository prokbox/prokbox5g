# #38 end review (finding 1): every main-menu panel drawn while audio
# plays, so scripts/check_trace.py's "paneldraw" rule sees each provider
# draw (sim-only "panel draw <name> playing allocs= opens=" lines) and
# fails one that allocates or opens a library view (the Podcasts count
# comes from the precompute, lib_podcast_count()).
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-nav-panels-playing.script
# needs: library

wait 4000            # boot to the main menu, "Music" selected
wait_db 30000
sim_clock 15:04
clock_format 24
battery 100

wheel +4             # "Shuffle Songs"
wait 400
key SELECT           # plays; the WPS
wait 1500
key MENU             # back to the main menu, "Shuffle Songs" selected
wait 700
wheel -3             # "Podcasts"
wait 800             # past NAV_REST_ICON + the cross-fade
shot podcasts_playing
wheel +1             # "Extras"
wait 800
shot extras_playing
wheel +1             # "Settings"
wait 800
shot settings_playing
wheel -3             # "Music": the drift
wait 1600
shot music_playing

quit
