# Phase 18 (§8; Q6): asleep, a poll's battery read under disk-safe +
# 100 mV (sim: 3200 + 100) wakes with WAKE_LOWBATT and powers off; and a
# hold under 10 % powers off at once, never soft-sleeping.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p18-sleep-lowbatt.script
# golden: skip
# log: sleep wake why=5 s=60 polls=1 spurious=0
# logbetween: low_hold end no sim_sleep: sleep enter
# nolog: splash-pass

sleep_mode soft
wait 4000
battery 50
hold PLAY 1500          # the hold: dark at once, PLAY's release awaited
expect_sleep asleep 8000
batt_mv 3290            # under 3300
sleep_warp 60           # the next poll reads it
expect_sleep lowbatt 3000
wait 6000               # the power-off (the sim quits)
reboot
sleep_mode soft         # soft sleep on: the <10 % hold still powers off
wait 4000
battery 8               # Q6: under 10 %
shot low                # the gate needs one shot
ab_mark low_hold
hold PLAY 1500          # today's power-off, no soft sleep
wait 8000
quit
