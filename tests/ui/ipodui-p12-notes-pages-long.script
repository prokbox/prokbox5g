copy fixtures/notes/Welcome.txt /Notes/Archive%20of%20old%20project%20notes%20kept%20for%20reference%20and%20historyz/Old%20note%20029%20with%20a%20long%20descriptive%20title%20xxxxxxxxxxxxxxxxx.txt
usb_disconnect
wait 150
wait_db 45000
wait 3500
storage_idle
wait 1500
wheel +2            # Main Menu: "Extras"
wait 800
key SELECT
wait 1200
wheel +7            # Extras: to the last row (Stopwatch; the list does not wrap)
wait 600
wheel -2            # "Notes", counted from the end: the same with or without a Games row
wait 800
key SELECT
wait 1200
shot first          # the folder, then the long notes, cut with an ellipsis
wheel +12
wait 1000
shot across         # a window across two pages
wheel +33
wait 1200
shot middle
wheel +200 10       # a fast spin to the end
wait 1500
shot end
wheel -200 10       # and back to the top
wait 1500
shot top_again
wheel +40
wait 1200
key SELECT          # a long note: opened by its full name
wait 1500
shot view
key MENU
wait 1200
shot back
wheel -200 10
wait 1500
key SELECT          # the long folder (its full name read apart)
wait 1500
shot folder
wheel +25
wait 1200
shot folder_end
key MENU
wait 1200
key MENU
wait 800
key MENU
wait 800
