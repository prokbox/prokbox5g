# P12 W3-K review (HIGH: blank rows across pages): Notes with FAT long
# names of 60 characters (90 in the root and a folder of a 60-character
# name holding 30 more). Each row's label is cut to the index's label size
# with an ellipsis and its full name kept apart (read when it opens); a
# page holds XIDX_PAGE_ROWS_MIN rows, so every window is in two pages and
# no row is ever blank ("notes row blank" never logs). Slow and fast
# spins (10 ms clicks: the page-load budget, no "pages" viol), a long
# note opened by its full name, the long folder opened and scrolled. The
# files are removed at the end.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-notes-pages-long.script
# needs: library
# timeout: 360
# modclass: paged
# log: xidx build kind=1 n=121
# log: notes open n=121 whole=0 rc=0
# log: notes page p=
# log: notes view r=
# nolog: notes row blank
# nolog: enc=0 ok=0
# golden: skip
# reset: mainmenu

