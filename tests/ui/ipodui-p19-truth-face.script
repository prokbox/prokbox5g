# P19 19-2 screen truth (phase19-brief.md 3.6), row: the unlit face (unlit.c enter, M6).
# The drift runs as jobs the device's way (bcm_drift on): the BCM owns
# the panel and the framebuffer's copy is poisoned (drift_jobs.c), so a
# reader or writer that skips ui_fb_settle() shows: "shot POISONED" (the
# framebuffer's panel reached a shot) or "glass owned STALE" (a write
# into the owned rect that never reached the glass).  The settled shots
# must equal the same script's run with bcm_drift off (the CPU path):
#   SIM_BUILD=build/sim-ui-video scripts/shots.sh tests/ui/ipodui-p19-truth-face.script
# needs: library
# needs: video
# golden: skip
# nolog: shot POISONED
# nolog: glass owned STALE

bcm_drift on
wait 4000
wait_db 30000
sim_clock 15:04
clock_format 24
battery 100
drift_phase 0
wait 3000            # live: the fade, then pan steps as jobs (owned)
shot drift_owned
backlight_expire     # the unlit face: drawn before any panel tick
wait 1500
shot face
key MENU 50          # dismiss: the drift again
wait 2500
drift_phase 350 frozen   # a fixed framing for the comparison
wait 1200
shot drift_again
quit
