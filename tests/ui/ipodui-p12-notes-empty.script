# P12 W1-N (docs/phase12-brief.md 8 row 10, 9 "-notes-empty"): an empty
# /Notes (or none: the indexer makes the folder, Q12) gives an index with
# no rows; Notes shows its empty state, our own sentence, no rows and no
# spinner. MENU backs out.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p12-notes-empty.script
# needs: library
# timeout: 180
# log: xidx build kind=1 n=0
# log: notes open n=0 whole=1 rc=0
# nolog: modclass viol
# expect-exists: /Notes
# golden: skip
# reset: mainmenu

sim_clock 15:06
wait 4000
wait_db 30000
rm_file /Notes/Shopping.txt
rm_file /Notes/Welcome.txt
rm_file /Notes/Long%20note.txt
rm_file /Notes/Unicode%20note.txt
rm_file /Notes/Windows%20note.txt
rm_file /Notes/._Shopping.txt
rm_file /Notes/readme.md
rm_file /Notes/Trips/Paris.txt
rm_file /Notes/Trips/Lisbon.TXT
rm_file /Notes/Trips
rm_file /.rockbox/notes.idx
rm_file /.rockbox/xindex.owe
rm_file /Notes
usb_connect
wait 2500
usb_disconnect
wait 150
wait_db 45000
wait 3500           # the grace and gap windows end the busy moment: the
storage_idle        # indexer runs there (xidx build)
wait 1500
wheel +2            # Main Menu: "Extras"
wait 800
key SELECT
wait 1200
wheel +7            # Extras: to the last row (Stopwatch; the list does not wrap)
wait 600
wheel -2            # "Notes", counted from the end: the same with or without a Games row
wait 800
key SELECT
wait 1200
shot empty
key MENU
wait 1000
shot back_extras
quit
