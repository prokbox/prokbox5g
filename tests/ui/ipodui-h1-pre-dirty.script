# H1 (#41.1, #41.2), DB state "dirty" (docs/process.md checklist item 10):
# a power cut mid-commit leaves the database dirty; the next boot still
# reserves the precompute block from the master index header ("lib
# reserve entries=N") and rebuilds the database silently in the
# background. The rebuilt database's precompute runs in that block, and
# so does the one after a deleted-file pass during playback ("block=
# reserved playing=1"); the builder's pass runs once the user is idle
# (#58: the clock face up) and its GC waits for the stop ("art build gc
# deferred", then "gc=1 playing=0"). Playback never stops.
# With library generations (#85, cache-persist): a deleted-file pass while
# music plays builds a candidate whose RAM cache cannot be allocated
# beside the playing audio buffer, so the new generation waits for the
# stop ("RAM cache reload ... waits for playback to stop"); the active
# library stays as it was (and browsable) meanwhile. The pass is started
# with update_db and checked with expect_db_gen_same while playing and
# expect_db_gen_change after the stop, instead of update_db_wait_change
# during playback; the precompute then runs after the stop.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-h1-pre-dirty.script
# needs: library
# golden: skip stopped
# log: art build commit
#
# shots.sh fails the run on "dirty_db failed" and "expect_* failed".

wait 1000
wait_db 30000
remove /Music/refresh-fixture.mp3
update_db_wait 30000
art_wait 120000
dirty_db            # the power cut mid-commit, as the disk is left
reboot

wait 1500           # boot 2: dirty, rebuilt in the background
wait_db 45000
art_wait 120000
copy fixtures/refresh.mp3 /Music/refresh-fixture.mp3
update_db_wait_change 30000
art_wait 120000

wheel +4            # "Shuffle Songs"
wait 500
key SELECT          # plays
wait 1500
expect_playing 300
db_gen_mark
remove /Music/refresh-fixture.mp3
update_db                           # the deleted-file pass, while playing
wait 2000
expect_db_gen_same 2000             # waits for the stop (generations)
expect_playing 2000
key MENU            # main menu (the face is dismissed over it)
wait 1000
backlight_expire    # the user idle (#58): the builder's pass
art_wait 30000
expect_playing 300
key MENU            # wakes: the face goes (the key is swallowed)
wait 1000
audio_stop       # stop: the new generation, the GC and the panels
expect_db_gen_change 60000
wait 3000
art_wait 60000
expect_art art_manifest.txt
shot stopped

quit
