# Phase 16-1 re-review (M-a): a wake and a press during the window's
# restart (held 5 s). The screen lights while the song restarts:
# Now Playing's source still has the song (title, length: expect_title),
# not a blank 0:00 entry; and PLAY does not block the UI thread until
# the restart ends: it queues, the list still moves meanwhile, and the
# song resumes once the restart is over.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-p16-restart-wake.script
# needs: library
# needs: ab
# golden: skip
# timeout: 300
# fulls-extra: 3
# log: expect_title ok
# logbetween: p1 p2 update
# logbetween: p1 p2 no audio give done
# logbetween: p2 end audio give done

wait 4000
wait_db 45000
mkdir /Audiobooks/E16
copy ../../build/ab-fixtures/pref.m4b /Audiobooks/E16/pref.m4b
copy ../../build/ab-fixtures/short.m4b /Audiobooks/E16/short.m4b
update_db_wait_change 60000
play_files /Audiobooks/E16/pref.m4b
wait_pos 17000 90000
snapshot_pause
expect_paused 500
backlight_expire            # dark
pause_age 200               # paused 3 min 20 s: the window is open
give_hold 5000              # the next window restart holds 5 s
copy ../../tests/fixtures/plain.mp3 /Audiobooks/E16/new.mp3
update_db                   # its commit takes the window's memory
wait 2500                   # ... and the restart is held now
ab_mark held
key MENU                    # wake: the screen lights mid-restart
wait 400
expect_title
shot woke
key PLAY                    # queued behind the restart
wait 200
ab_mark p1
wheel +1 100                # the UI thread is not blocked
wait 500
ab_mark p2
expect_title
wait 6000
expect_playing 1000
expect_pos 16000 40000
quit
