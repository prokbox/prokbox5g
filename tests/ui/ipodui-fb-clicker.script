# #58 (owner, device): Clicker clicks. The shell reads buttons itself
# (input.c), so it calls keyclick_click() for every press, repeat and wheel
# event (upstream only clicks from get_action()). The simulator has no
# piezo: input.c traces each click keyclick_click() decides to sound as
# "click n=<count> btn=<hex>". Owner 2026-10-20: Off or On (On = the
# headphone click and the piezo together). On is the default (#142, as the
# 7G): navigating to Settings > Clicker (3 + 12 wheel events, 2 presses)
# clicks 17 times (n=1..17, the last being the press that turns it Off).
# Then 3 wheel events are silent; SELECT turns it On again (the press came
# while Off: no click); 6 wheel events click 6 times (n=18..23), the next
# SELECT press clicks (n=24) and turns it Off, and the 3 wheel events after
# that are silent: exactly 24.
# Device check (P10): the piezo and the haptic mod fire once per wheel
# detent and per press.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-fb-clicker.script
# golden: skip clicker_on clicker_off
# log: click n=17 btn=
# log: click n=24 btn=
# nolog: click n=25 btn=
wait 4000

wheel +3 300            # Settings (clicks: Clicker is On, n=1..3)
wait 400
key SELECT 50           # n=4
wait 1200
wheel +12 40            # Clicker (row 12), n=5..16
wait 800
text_mark               # Audiophile's screen must not open
key SELECT 50           # the press clicks (n=17); the release turns it Off
wait 800
expect_not_drawn Hi-Res   # landed on Clicker (row 12), not Audiophile (row 11)
shot clicker_off
wheel +3 200            # silent
wait 300
wheel -3 200            # silent, back on Clicker
wait 600
key SELECT 50           # On (pressed while Off: no click)
wait 800
shot clicker_on
wheel +3 200            # 3 clicks, n=18..20
wait 300
wheel -3 200            # 3 clicks, n=21..23, back on Clicker
wait 600
key SELECT 50           # the press clicks (n=24); the release turns it Off
wait 800
wheel +3 200            # silent
wait 600
wheel -3 200            # silent, back on Clicker
wait 300
key SELECT 50           # On again (the default) for the scripts after this
wait 4000               # saved
quit
