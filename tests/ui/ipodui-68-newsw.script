# Tracker #68: the native "New Software" prompt after USB. A new firmware
# file copied over USB (its mtime changes while the computer has the disk)
# shows the shell's own light prompt, Restart | Later, Restart preselected,
# in place of the stock yes/no. Later leaves the shell as it was. Restart
# (#316) is a real restart: the choice is logged and flushed ("boot
# restart chosen"), SYS_REBOOT runs the power-off's saves (input.c:
# "power reboot"; clean_shutdown(): the settings, the database's stamp)
# and system_reboot(), which ends the simulator here (the device resets
# and its bootloader loads the new file). Red before #316: rolo_load(),
# no SYS_REBOOT, nothing saved.
#   SIM_BUILD=build/sim-ui scripts/shots.sh tests/ui/ipodui-68-newsw.script
# needs: library
# log: bootfile changed choice=later
# log: bootfile changed choice=restart
# logafter: restart boot restart chosen
# logafter: restart power reboot batt=
# logafter: restart Writing system_status to disk
# nolog: splash
# golden: skip
#
# The boot file is a stand-in (any file) at /.rockbox/rockbox.ipod; the
# 2.5 s waits keep the two writes in different seconds (mtime resolution).

wait 4000
mkdir /.rockbox
copy fixtures/refresh.mp3 /.rockbox/rockbox.ipod
wait 1200
shot before

# 1. unchanged during USB: no prompt
usb_connect
wait 2500
usb_disconnect
wait 2000
shot unchanged       # the main menu, no prompt

# 2. changed during USB: prompt, Later
usb_connect
wait 2500
copy_file /.rockbox/rockbox.ipod /.rockbox/rockbox.new
rm_file /.rockbox/rockbox.ipod
copy_file /.rockbox/rockbox.new /.rockbox/rockbox.ipod
usb_disconnect
wait 2000
shot prompt          # Restart selected
wheel +1
wait 500
shot later_selected
key SELECT
wait 1500
shot after_later     # back on the main menu

# 3. changed again: Restart
usb_connect
wait 2500
rm_file /.rockbox/rockbox.ipod
copy_file /.rockbox/rockbox.new /.rockbox/rockbox.ipod
usb_disconnect
wait 2000
shot prompt_again
rm_file /.rockbox/rockbox.ipod  # the stand-ins go first: the restart
rm_file /.rockbox/rockbox.new   # ends the simulator
ab_mark restart
key SELECT           # Restart preselected
wait 8000            # the clean shutdown, then the simulator's reboot
shot after_restart   # not reached: the simulator has restarted
quit
