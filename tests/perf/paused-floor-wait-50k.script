# Phase 16-1 (#88, Q11): the window must wait when the commit is too big
# for the floor. 32 MB unit at 50k: the audio file buffer is first made
# smaller by 6 MB (floor_reserve: the 15.08 MB receipt of hardware.md, as
# after an earlier shrink that no cold start has undone), so the commit's
# ~7.9 MB peak would leave it under 7,500,000 B: the window opens but
# refuses ("maint job=commit wait floor"), takes nothing, and the update
# waits for the stop, where it commits as today. Run by
# tests/perf/floor_gate.sh on the 32 MB build only.
# golden: skip waited
wait 4000
wait_db 300000
repeat all
floor_watch begin
snapshot_play
wait 2000
expect_playing 500
floor_reserve 0 6000000
wait 1500
floor shrunk_by_earlier
snapshot_pause
expect_paused 500
backlight_expire
copy ../../tests/ui/fixtures/refresh.mp3 /zz-floor-wait.mp3
db_mark
update_db
expect_snapshot_deferred 5000
pause_age 200
expect_snapshot_deferred 8000
expect_paused 500
shot waited
floor window_refused
audio_stop
expect_db_grew 300000
floor_release 0
key MENU
wait 1000
floor_watch end refused free
quit
