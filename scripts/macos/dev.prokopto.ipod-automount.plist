<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.prokopto.ipod-automount</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/ipod-automount</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/log/ipod-automount.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ipod-automount.log</string>
</dict>
</plist>
