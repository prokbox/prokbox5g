#!/bin/sh
# Host-compiler shim: every host test compiled through it aborts on a
# misaligned load/store (-fsanitize=alignment, no recovery). The PP5022
# data-aborts on a misaligned halfword/word access (docs/pp5022-reference/
# quirks.md #51); macOS/x86/arm64 hosts accept it silently, so without this
# the bug only shows on the device.
#
# scripts/test.sh puts this directory first on PATH (after building warble)
# and the shim is installed as cc, gcc and gcc-NN (symlinks to this file).
# ALIGN_SHIM=0 turns it off (e.g. to compare); a test that must keep a
# deliberate misaligned access sets ALIGN_SHIM_ALLOW=1 for that command.
real=
me=$(basename "$0")
d=$(cd "$(dirname "$0")" && pwd)
# find_real NAME: first NAME on PATH that is neither this shim nor a ccache
# masquerade link (Fedora puts /usr/lib64/ccache first; ccache would then
# re-find the shim ahead of the compiler and loop forever).
find_real() {
    IFS=:
    for p in $PATH; do
        [ "$p" = "$d" ] && continue
        [ -x "$p/$1" ] || continue
        case "$(readlink -f "$p/$1")" in */ccache) continue;; esac
        echo "$p/$1"; break
    done
    unset IFS
}
real=$(find_real "$me")
# Linux distros ship the host compiler as plain gcc (Fedora 44's is 16): a
# gcc-NN with no real gcc-NN uses a real gcc of the same major version.
case "$me" in gcc-[0-9]*)
    if [ -z "$real" ]; then
        g=$(find_real gcc)
        [ -n "$g" ] && [ "$("$g" -dumpversion | cut -d. -f1)" = "${me#gcc-}" ] && real=$g
    fi;;
esac
[ -n "$real" ] || { echo "align-shim: no real $me on PATH" >&2; exit 127; }
if [ "${ALIGN_SHIM:-1}" = 0 ] || [ "${ALIGN_SHIM_ALLOW:-0}" = 1 ]; then exec "$real" "$@"; fi
# preprocess-only / version probes need no sanitizer
for a in "$@"; do case "$a" in -E|-M|-MM|--version|-dumpversion|-dumpmachine|-v) exec "$real" "$@";; esac; done
exec "$real" -fsanitize=alignment -fno-sanitize-recover=alignment "$@"
