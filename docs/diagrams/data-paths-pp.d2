# ProkBox hardware manual: data paths, (b) the PP5022 side.
# Every PP-side bus master, what it reaches, its status and its measured rate, in two panels:
# into the PP's own memory, and out of the PP (to the BCM's port and the I2S FIFO). A master
# that does both appears in both panels.
# Facts: docs/data-paths.md §2 (M1–M8), §3, §4 cells 1–3, 8–16 (the number in brackets on each edge).
...@paths-style

direction: down

title: |md
  # PP5022 side: who moves bytes, and where to
  Each arrow is a master reaching a target; (n) is its cell in docs/data-paths.md §4 (status as of S37)
| {class: title; near: top-center}

# ---- panel 1: into the PP's own memory -----------------------------------------
mem: "1 · Into the PP's own memory" {
  class: chip_pp
  label.near: top-left
  direction: right

  computer: "Computer\n(USB-C)" {class: out}
  flash: "1 TB flash\n(ATA disk)" {class: out}

  usb: "USB controller + DMA\n≈ 18.5 MB/s end to end" {class: pp}
  cores: "CPU and COP\n2 × ARM7TDMI, no cache\ncoherency between them" {class: pp}
  ide: "IDE controller + DMA\nUDMA2, 21 MB/s" {class: pp}
  dma2: "Second DMA engine\n64 KB in 5.5 ms" {class: pp}
  dma13: "General DMA, channels 1–3\nmemory → memory moved\nnothing (S37)" {class: pp}

  iram: "IRAM 128 KB\nuncached, shared by both cores" {class: mem}
  sdram: "SDRAM 64 MB\ncached at 0x0, uncached at 0x1000_0000\n(DMA uses the uncached address)" {class: mem}

  computer <-> usb {class: e_si}
  flash -> ide {class: e_si}

  usb -> iram: "descriptors (16)" {class: e_si}
  cores -> iram: "(1, 8)" {class: e_si}
  usb -> sdram: "data (16)" {class: e_si}
  cores -> sdram: "(1, 8)" {class: e_si}
  ide -> sdram: "(15)" {class: e_si}
  dma2 -> sdram: "(14)" {class: e_si}
  dma13 -> sdram: "(12)" {class: e_dead}
}

# ---- panel 2: out of the PP -----------------------------------------------------
out: "2 · Out of the PP: to the BCM and the codec (all read SDRAM)" {
  class: chip_pp
  label.near: top-left
  direction: right

  cpu: "CPU (ARM7TDMI)\n5.7 MB/s at 30 MHz\n16 MB/s at 80 MHz" {class: pp}
  dma2: "Second DMA engine (S37)\n64 KB in 5.8 ms; the CPU\nkeeps 77–97 % of its time" {class: pp}
  cop: "COP" {class: pp}
  dma13: "General DMA, channels 1–3" {class: pp}
  dma0: "General DMA, channel 0" {class: pp}

  port: "Host port\n0x3000_0000, 16-bit" {class: pp}
  i2s: "I2S FIFO\n0x7000_2840" {class: pp}

  bcm: "BCM2722\n(see data-paths-bcm)" {class: bcm}
  wm: "WM8758\n(see data-paths-audio)" {class: wm}

  cpu -> port: "copy (2, 3)" {class: e_si}
  dma2 -> port: "every word right (14)" {class: e_si}
  cop -> port: "untried (9)" {class: e_unk}
  dma13 -> port: "nothing landed, S34–S37 (13)" {class: e_dead}
  dma0 -> i2s: "176 KB/s (10)" {class: e_si}
  port -> bcm: "the only path\nbetween the chips" {class: e_si}
  i2s -> wm: "I2S" {class: e_si}
}

mem -> out: "" {style.opacity: 0}

key: "" {
  near: bottom-center
  style: {fill: transparent; stroke: transparent}
  grid-columns: 2
  horizontal-gap: 40
  legend: @paths-legend
  note: |md
    **Not drawn** (unknown, never tried): the DMA engines\
    and the IDE controller into IRAM (cells 11, 14);\
    the COP on peripherals and I2C (9).

    **No path back:** the BCM cannot write PP memory (17);\
    the PP fetches its results by port reads.

    Sources: docs/data-paths.md §2–§4. Our own drawing.
  | {class: note}
}
